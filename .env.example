# Copy this file to ``.env`` and fill in values for your environment.
# ``python-dotenv`` is loaded by ``gee_mcp.server.auth`` on import, so any
# variables set here will be picked up automatically when the server
# starts.

# ----------------------------------------------------------------------
# Gemini (pick ONE of the two paths below)
# ----------------------------------------------------------------------

# Path A — Gemini Developer API key
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Path B — Vertex AI project (requires ``gcloud auth
# application-default login`` to have been run)
# VERTEXAI_PROJECT=your-vertexai-project
# VERTEXAI_LOCATION=global

# ----------------------------------------------------------------------
# Google Earth Engine
# ----------------------------------------------------------------------

# Required: the GEE project id used for ``ee.Initialize(project=...)``.
GEE_PROJECT=your-gee-project

# Optional: explicit path to a service-account JSON key file.
# Tried first by ``setup_gee``; if unset, the auth chain falls through
# to env-var-based service accounts, default user creds, then
# interactive auth.
# GEE_KEY_PATH=/absolute/path/to/service-account.json

# Optional: env-var-based service-account flow (level 2 of the auth
# chain). Both vars must be set for this path to be tried.
# GEE_SERVICE_ACCOUNT=name@project.iam.gserviceaccount.com
# EE_SERVICE_ACCOUNT=name@project.iam.gserviceaccount.com   # alias
# GEE_PRIVATE_KEY_PATH=/absolute/path/to/private-key.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/private-key.json

# Optional: auth mode passed to ``ee.Authenticate`` if all earlier
# levels fail. Default is ``gcloud``.
# GEE_AUTH_MODE=gcloud

# ----------------------------------------------------------------------
# Test / CI escape hatch
# ----------------------------------------------------------------------

# Set to ``1`` to skip GEE auth entirely on import. Used by the test
# suite to avoid hitting the auth chain in CI. Do not set for normal
# use.
# GEE_SKIP_AUTH=1
